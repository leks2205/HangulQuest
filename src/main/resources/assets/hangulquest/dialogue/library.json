{
	"schema": 1,
	"id": "library",
	"level": 2,
	"trigger": {"entity": "minecraft:villager", "profession": "minecraft:librarian", "baby": false},
	"start": "hello",
	"nodes": {
		"hello": {
			"speaker": "librarian",
			"ko": "어서 오십시오. 저는 사서입니다.",
			"next": "need"
		},
		"need": {
			"speaker": "librarian",
			"ko": "책이 필요합니다.",
			"effects": [{"type": "exposeWords", "words": ["concept:book"]}],
			"next": "ask"
		},
		"ask": {
			"speaker": "librarian",
			"ko": "책을 한 권 가져와 주시겠습니까?",
			"grammar": "L5.hapsyo",
			"choices": [
				{"ko": "네, 가져오겠습니다.", "speechLevel": "hapsyo", "correct": true, "next": "offer"},
				{"ko": "응, 가져올 거야.", "speechLevel": "banmal", "correct": false}
			]
		},
		"offer": {
			"speaker": "librarian",
			"ko": "특별한 책도 있습니다. 보시겠습니까?",
			"choices": [
				{"ko": "네, 보겠습니다.", "speechLevel": "hapsyo", "next": "show"},
				{"ko": "아니요, 괜찮습니다.", "speechLevel": "hapsyo", "next": "thanks"}
			]
		},
		"show": {
			"speaker": "librarian",
			"ko": "에메랄드와 책이 필요합니다.",
			"effects": [{"type": "exposeWords", "words": ["concept:emerald"]}],
			"next": "thanks"
		},
		"thanks": {
			"speaker": "librarian",
			"ko": "감사합니다. 안녕히 가십시오.",
			"end": true
		}
	}
}
