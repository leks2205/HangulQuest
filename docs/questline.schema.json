              "$ref": "#/definitions/resourceId"
            },
            "change": {
              "enum": [
                "ON",
                "OFF"
              ],
              "description": "ON (the default) puts the armour piece on, OFF takes it off."
            }
          },
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
