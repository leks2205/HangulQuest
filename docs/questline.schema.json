            }
          },
          "required": [
            "type",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "HEAR"
            },
            "source": {
              "$ref": "#/definitions/resourceId"
            },
            "radius": {
              "type": "integer",
              "minimum": 2,
              "maximum": 16
            },
            "dwellMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            }
          },
          "required": [
            "type",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "LIE_DOWN"
            },
