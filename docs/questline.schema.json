              "pattern": "^(#?[a-z0-9_.-]+:[a-z0-9_./-]+|@[A-Za-z0-9_-]+)$",
              "description": "A block, an entity, or a block tag such as #minecraft:logs."
            },
            "kind": {
              "enum": [
                "block",
                "item",
                "entity"
              ],
              "description": "What the anchor is, when its id could be an item and an entity (chicken)."
            }
          },
          "required": [
            "type",
            "relation",
            "anchor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "teach",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,24}$"
        },
        "teach": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "description": "Concept id from concepts.json; the first one supplies the noun of the sentence."
          }
        },
        "goal": {
          "$ref": "#/definitions/goal"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "clue": {
          "$ref": "#/definitions/clue"
        },
        "hint": {
          "$ref": "#/definitions/clue"
        },
        "reverse": {
          "type": "boolean",
          "description": "A \"find the 돌\" step: the log and the journal show only the Korean, no icon and no translation. Only for LOOK_AT_BLOCK, LOOK_AT_ENTITY, BREAK_BLOCK, ACQUIRE_ITEM and PLACE_REL goals; a completed step counts as unaided recall."
        },
        "bonus": {
          "type": "object",
          "description": "Parsed for forward compatibility; not evaluated in 1.x.",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "NEAR_STRUCTURE"
            },
            "structure": {
              "type": "string"
            },
            "radius": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,64}$",
      "description": "Stable lowercase id; also the file name and the badge id. Never change it after release."
    },
    "titleKo": {
      "$ref": "#/definitions/koreanText"
    },
    "titleEn": {
      "type": "string",
      "description": "Inline English title for a player's own file; shipped trails use the key hangulquest.trail.<id>.title. Wins over the key."
    },
    "titleDe": {
      "type": "string",
      "description": "Inline German title for a player's own file; shipped trails use the key hangulquest.trail.<id>.title. Wins over the key."
    },
    "demo": {
      "type": "boolean",
      "description": "Marks a trail that shows off a new kind of task. The game ignores the flag; tools may use it."
    },
    "topic": {
      "$ref": "#/definitions/koreanText"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "koreanLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Concept ids shown in the journal under this trail."
      }
    },
    "grammar": {
      "type": "array",
      "description": "Optional. The constructions of grammar.json the trail is meant to practise (ids such as L2.seyo, or a ladder alias). The game checks every id and ignores the unknown ones; tools list them next to the trail.",
      "items": {
        "type": "string",
        "pattern": "^L[1-6]\\.[a-z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minWordsKnown",
        "dimension"
      ],
      "properties": {
        "minWordsKnown": {
          "type": "integer",
          "minimum": 0
        },
        "dimension": {
          "$ref": "#/definitions/resourceId"
        },
        "completed": {
          "type": "array",
          "description": "Parent trail ids. Absent or empty for a root.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "finale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "textKo"
      ],
      "properties": {
        "step": {
          "$ref": "#/definitions/step"
        },
        "textKo": {
          "$ref": "#/definitions/koreanText"
        },
        "textDe": {
          "type": "string",
          "minLength": 1,
          "description": "Inline German ceremony text for a player's own file; shipped trails use the key hangulquest.trail.<id>.finale. Wins over the key."
        },
        "textEn": {
          "type": "string",
          "minLength": 1,
          "description": "Inline English ceremony text for a player's own file; shipped trails use the key hangulquest.trail.<id>.finale. Wins over the key."
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge",
        "words"
      ],
      "properties": {
        "badge": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "override": {
      "type": "boolean",
      "description": "Only used in config/hangulquest/questlines/: lets this file replace a shipped trail with the same id."
    }
  }
}
