              ],
              "description": "Also wait for this part of the day."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "BREED"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "entity",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "MOUNT"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            },
            "dwellMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 30000
            }
          },
          "required": [
            "type",
            "entity"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
