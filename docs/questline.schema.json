              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "TRADE"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "entity": {
              "$ref": "#/definitions/resourceId",
              "description": "The merchant; a villager when left out."
            },
            "direction": {
              "enum": [
                "BUY",
                "SELL"
              ],
              "description": "BUY gets the item from the merchant, SELL pays with it."
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item",
