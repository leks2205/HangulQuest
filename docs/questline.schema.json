{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/leks2205/HangulQuest/main/docs/questline.schema.json",
  "title": "Hangul Quest questline",
  "description": "One questline: clues that build on each other, a ritual finale and a reward. Files live in src/main/resources/assets/hangulquest/data/questlines/ or in config/hangulquest/questlines/ inside the player's instance. Korean fields must be Hangul-only. The English and German text of shipped trails (titles, clues, hints, finale text) is not in the file: it lives in assets/hangulquest/lang/content/<code>.json under hangulquest.trail.<id>.* keys. The inline fields titleEn, titleDe, clue.en/de, hint.en/de and finale.textEn/textDe are still read, for questline files a player or a resource pack adds, and they win over the keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "titleKo",
    "topic",
    "tier",
    "order",
    "koreanLevel",
    "concepts",
    "requires",
    "steps",
    "finale",
    "reward"
  ],
  "definitions": {
    "koreanText": {
      "type": "string",
      "minLength": 1,
      "description": "Hangul only. Digits and punctuation are allowed; Latin letters, romanisation and emoji are not."
    },
    "resourceId": {
      "type": "string",
      "pattern": "^#?[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Namespaced Minecraft id, e.g. minecraft:stone, or a tag such as #minecraft:logs."
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "anyOf": [
        {
          "required": [
            "ko"
          ]
        },
        {
          "required": [
            "de"
          ]
        },
        {
          "required": [
            "en"
          ]
        }
      ],
      "properties": {
        "ko": {
          "$ref": "#/definitions/koreanText"
        },
        "de": {
          "type": "string",
          "description": "Inline German line for a player's own file, shown when German is the interface language and translations are on. Shipped trails use the keys hangulquest.trail.<id>.step.<step>.clue and .hint. Wins over the key."
        },
        "en": {
          "type": "string",
          "description": "Inline English line for a player's own file, shown when English is the interface language and translations are on. Shipped trails use the keys hangulquest.trail.<id>.step.<step>.clue and .hint. Wins over the key."
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "BREAK_BLOCK"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "verb": {
              "enum": [
                "MINE",
                "DIG",
                "CHOP",
                "SNAP",
                "HARVEST",
                "PICK",
                "PULL",
                "SHATTER",
                "BREAK"
              ],
              "description": "Picks the verb of the generated sentence: any verb the verb table (verbs.json) uses for breaking, e.g. 캐다 / 베다 / 파다 / 꺾다 / 수확하다."
            }
          },
          "required": [
            "type",
            "block",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "PLACE_BLOCK"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "block",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "ACQUIRE_ITEM"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "CONSUME_ITEM"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "LOOK_AT_BLOCK"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "dwellMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          },
          "required": [
            "type",
            "block",
            "dwellMs"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "LOOK_AT_ENTITY"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            },
            "dwellMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          },
          "required": [
            "type",
            "entity",
            "dwellMs"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "DEFEAT_ENTITY"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "entity",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "REACH_BIOME"
            },
            "biome": {
              "$ref": "#/definitions/resourceId"
            },
            "dwellMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          },
          "required": [
            "type",
            "biome",
            "dwellMs"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "REACH_DIMENSION"
            },
            "dimension": {
              "$ref": "#/definitions/resourceId"
            }
          },
          "required": [
            "type",
            "dimension"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "REACH_HEIGHT"
            },
            "minY": {
              "type": "integer",
              "minimum": -256,
              "maximum": 512
            },
            "maxY": {
              "type": "integer",
              "minimum": -256,
              "maximum": 512
            }
          },
          "required": [
            "type",
            "minY",
            "maxY"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "USE_BLOCK"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "change": {
              "enum": [
                "OPEN",
                "CLOSE",
                "LIT"
              ],
              "description": "Open or close a door, trapdoor or fence gate, or light a candle or campfire (LIT): the block must really change state. Without it any use of the block counts, except that a candle has to be lit."
            }
          },
          "required": [
            "type",
            "block"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "INTERACT_ENTITY"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            }
          },
          "required": [
            "type",
            "entity"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "PLACE_REL"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "relation": {
              "enum": [
                "ON_TOP_OF",
                "UNDER",
                "NEXT_TO",
                "IN_FRONT_OF",
                "BEHIND",
                "INSIDE",
                "OUTSIDE",
                "BETWEEN",
                "NEAR"
              ],
              "description": "Where the block goes, relative to the anchor."
            },
            "anchor": {
              "type": "string",
              "pattern": "^(#?[a-z0-9_.-]+:[a-z0-9_./-]+|@[A-Za-z0-9_-]+)$",
              "description": "The block, family or tag the relation is measured against, or @stepId for the block placed in that earlier step of the trail (trail level 5 or higher)."
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "anchor2": {
              "$ref": "#/definitions/resourceId",
              "description": "With BETWEEN: the second block, so the Korean says A와/과 B 사이에 instead of 두 A 사이에."
            }
          },
          "required": [
            "type",
            "block",
            "relation",
            "anchor",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "BUILD_PATTERN"
            },
            "pattern": {
              "enum": [
                "PILLAR",
                "PYRAMID",
                "RING",
                "ROW",
                "WALL",
                "CROSS",
                "STAIRS"
              ],
              "description": "The shape to build."
            },
            "material": {
              "$ref": "#/definitions/resourceId"
            },
            "size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            }
          },
          "required": [
            "type",
            "pattern",
            "material"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "PLACE_ON_PATTERN"
            },
            "block": {
              "$ref": "#/definitions/resourceId"
            },
            "relation": {
              "enum": [
                "ON_TOP_OF",
                "UNDER",
                "NEXT_TO",
                "IN_FRONT_OF",
                "BEHIND",
                "INSIDE",
                "OUTSIDE",
                "BETWEEN",
                "NEAR"
              ],
              "description": "Where the block goes, relative to the structure."
            },
            "pattern": {
              "enum": [
                "PILLAR",
                "PYRAMID",
                "RING",
                "ROW",
                "WALL",
                "CROSS",
                "STAIRS"
              ],
              "description": "The shape of the structure."
            },
            "material": {
              "$ref": "#/definitions/resourceId"
            }
          },
          "required": [
            "type",
            "block",
            "relation",
            "pattern",
            "material"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "CRAFT"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "station": {
              "enum": [
                "cartography",
                "crafting_table",
                "grindstone",
                "inventory2x2",
                "loom",
                "smithing",
                "stonecutter"
              ],
              "description": "Where it is made; any crafting screen when left out."
            },
            "with": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/resourceId"
              },
              "description": "Ingredients named in the sentence (와/과 and (으)로). Only the wording, not checked."
            }
          },
          "required": [
            "type",
            "item",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "SMELT"
            },
            "input": {
              "$ref": "#/definitions/resourceId"
            },
            "output": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "output",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "GIVE"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "entity": {
              "$ref": "#/definitions/resourceId"
            },
            "method": {
              "enum": [
                "FEED",
                "USE_WITH",
                "DROP_NEAR",
                "TRADE"
              ],
              "description": "Only this way of giving counts; DROP_NEAR is spoken as 앞에 … 떨어뜨려요."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "type",
            "item",
            "entity"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "PUT_IN"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "container": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item",
            "container",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "HOLD_WHILE"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "inner": {
              "oneOf": [
                {
                  "$ref": "#/definitions/goal"
                },
                {
                  "$ref": "#/definitions/condition"
                }
              ],
              "description": "A goal that only counts while the item is held, or a condition that must hold while walking with it."
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          },
          "required": [
            "type",
            "item",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "SEQUENCE"
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/goal"
              },
              "minItems": 2,
              "maxItems": 3,
              "description": "The goals, in the order they have to happen."
            },
            "ordered": {
              "type": "boolean",
              "description": "False lets the parts happen in any order (default true)."
            },
            "connector": {
              "enum": [
                "BEFORE",
                "AFTER",
                "THEN",
                "AND"
              ],
              "description": "Which Korean connective ties the two parts of an ordered sequence; chosen from the parts when left out. AND is the plain -고 (level 2); the order is checked all the same."
            }
          },
          "required": [
            "type",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "AVOID"
            },
            "action": {
              "$ref": "#/definitions/goal",
              "description": "The action that must not happen."
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "during": {
              "$ref": "#/definitions/condition",
              "description": "The window only runs, and the action only counts, while this holds."
            }
          },
          "required": [
            "type",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "TAKE_OUT"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "container": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "item",
            "container",
            "count"
          ],
          "additionalProperties": false
        },
