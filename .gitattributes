# Normalise line endings so the Gradle wrapper and the JSON stay usable on every platform.
* text=auto eol=lf

*.jar binary
*.ttf binary
*.png binary
*.webp binary
*.ogg binary

*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Keep generated reports out of diffs and language statistics.
src/main/resources/assets/hangulquest/data/questlines/index.json linguist-generated=true
docs/book/src/quest-tree.md linguist-generated=true
